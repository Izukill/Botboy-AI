
generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model Chat {
  id        String    @id @default(uuid())
  title     String    
  createdAt DateTime  @default(now())
  messages  Message[] 
}

// Cada balão de texto da conversa
model Message {
  id        String   @id @default(uuid())
  chatId    String
  role      String   
  content   String   
  createdAt DateTime @default(now())
  chat      Chat     @relation(fields: [chatId], references: [id])
}
